[Unit]
Description=Chimera networked API
After=network.target

[Service]
Type=simple
User=chimera
Group=chimera
WorkingDirectory=/srv/chimera/backend
EnvironmentFile=/etc/chimera/networked.env
ExecStart=/srv/chimera/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/chimera/networked-workspace

[Install]
WantedBy=multi-user.target
