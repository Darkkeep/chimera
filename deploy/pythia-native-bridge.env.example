# Chimera Hosted native SVG/GIF bridge. Server-side only, never in frontend builds.
# These values do NOT change consultation, LMS, or ordinary Engine connectivity.
# The browser calls Chimera's same-origin /api; only Chimera's backend contacts
# the Pythia public HTTPS Gateway, which forwards only a strict route allowlist.
#
# These are examples. No file under deploy/ is loaded automatically.
# Use the real public Pythia Gateway URL, not Render's private Engine DNS.
CHIMERA_PYTHIA_NATIVE_BASE_URL=https://pythia-showcase-79i4.onrender.com/v1/chimera-engine
# Independent strong token, exactly matching Gateway's
# PYTHIA_GATEWAY_CHIMERA_NATIVE_TOKEN. Do not use any OAuth, consultation,
# Render API, Pythia Engine or image-provider key here.
CHIMERA_PYTHIA_NATIVE_API_KEY=replace-with-a-strong-private-service-token
#
# Keep the existing CHIMERA_PYTHIA_BASE_URL and CHIMERA_PYTHIA_API_KEY values
# as configured for nonnative Engine operations. No fallback from the native
# bridge to public OAuth or to an unauthenticated private Engine.
#
# Activation requires the Gateway opt-in + Pythia Engine's separate native
# media opt-in, both using their own distinct credentials.
