# Hosted Pythia consultation settings for a team deployment.
# Append these to the backend environment file (for example
# /etc/chimera/networked.env) and restart the Chimera backend service.
# Setting any credential below switches Consult Pythia to the hosted engine;
# partial configuration fails closed with an actionable message.
# These are configuration examples, not files automatically loaded by Chimera.

# Exact origin of the hosted Pythia engine. On a single VPS keep the engine
# bound to loopback and use the HTTP loopback form; across hosts use HTTPS.
CHIMERA_PYTHIA_BASE_URL=http://127.0.0.1:8001

# Bearer token registered as the engine's PYTHIA_HOSTED_SERVICE_TOKEN.
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHIMERA_PYTHIA_SERVICE_TOKEN=replace-with-service-token

# Bearer token the engine presents to /api/internal/pythia/turn-access;
# must match the engine's PYTHIA_HOSTED_CALLBACK_TOKEN and differ from the
# service token. At least 32 characters.
CHIMERA_PYTHIA_CALLBACK_TOKEN=replace-with-callback-token

# Ed25519 PRIVATE key. Either inline PEM or, because systemd environment
# files cannot hold multiline values, an absolute path to a PEM file that is
# readable only by the Chimera service user (chmod 600).
# Generate the pair:
#   openssl genpkey -algorithm ed25519 -out /etc/chimera/pythia-signing.pem
#   openssl pkey -in /etc/chimera/pythia-signing.pem -pubout   # -> engine's PYTHIA_HOSTED_PUBLIC_KEY
CHIMERA_PYTHIA_SIGNING_KEY=/etc/chimera/pythia-signing.pem

# Must match the engine's PYTHIA_HOSTED_KEY_ID and PYTHIA_HOSTED_TENANT_ID.
CHIMERA_PYTHIA_KEY_ID=chimera-key-1
CHIMERA_PYTHIA_TENANT_ID=darkrogue

# Client ceilings; the engine's advertised capacity can lower these values.
CHIMERA_PYTHIA_CONTEXT_CHARS=200000
CHIMERA_PYTHIA_MESSAGE_CHARS=100000
CHIMERA_PYTHIA_HISTORY_MESSAGES=100
CHIMERA_PYTHIA_REQUEST_BYTES=1048576
