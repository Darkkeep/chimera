  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darkkeep/chimera.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Darkkeep/chimera/issues"
  },
  "homepage": "https://github.com/Darkkeep/chimera#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.59.1",
    "@types/node": "^26.6.4"
  },
  "workspaces": [
    "packages/onboarding",
    "examples/onboarding-demo"
  ]
}
